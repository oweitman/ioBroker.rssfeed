{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "default Launch ioBroker Adapter ",
            "skipFiles": ["<node_internals>/**"],
            "args": ["--debug", "0"],
            "program": "node_modules/iobroker.rssfeed/main.js",
            "cwd": "${workspaceFolder}/.dev-server/default",
            "stopOnEntry": false,
            "sourceMaps": true,
            "console": "internalConsole",
            "outputCapture": "std",
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "**/node_modules/**"]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "vis edit",
            "url": "http://127.0.0.1:8082/vis/edit.html#test",
            "trace": true,
            "skipFiles": ["socket.io.js"]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "vis runtime",
            "url": "http://127.0.0.1:8082/vis/index.html#test",
            "trace": true,
            "skipFiles": ["socket.io.js"]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "vis2 edit 3000",
            "url": "http://localhost:3000/edit.html#test",
            "trace": true,
            "skipFiles": ["socket.io.js"]
        },

        {
            "type": "chrome",
            "request": "launch",
            "name": "vis2 Launch runtime",
            "url": "http://localhost:8082/vis-2/?main#test",
            "trace": true,
            "skipFiles": ["socket.io.js"]
        },
        {
            "name": "repochecker remote",
            "program": "../iobroker.repochecker/index.js",
            "args": ["https://github.com/oweitman/ioBroker.squeezeboxrpc"],
            "request": "launch",
            "stopOnEntry": false,
            "runtimeExecutable": "c:/Users/oweit/AppData/Roaming/fnm/aliases/default/node.exe",
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        },
        {
            "name": "repochecker custom local",
            "program": "../iobroker.repochecker/index.js",
            "args": ["https://github.com/oweitman/ioBroker.squeezeboxrpc", "--local"],
            "request": "launch",
            "stopOnEntry": false,
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        }
    ]
}
